# Application Settings
PROJECT_NAME="Campus AI Event Discovery Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=

# Authentication & Security (Phase 3)
# SECURITY WARNING: Must be set in production! Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Email Configuration
EMAIL_BACKEND=console  # console, smtp, mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CampusConnect

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
RATE_LIMIT_VERIFY_ATTEMPTS=3
RATE_LIMIT_VERIFY_WINDOW_MINUTES=60
RATE_LIMIT_RESEND_ATTEMPTS=2
RATE_LIMIT_RESEND_WINDOW_MINUTES=60

# GenAI Configuration (Phase 6)
AI_PROVIDER=
AI_API_KEY=

# Navigate Labs API Configuration
NAVIGATE_API_BASE_URL=https://api.navigateai.co
NAVIGATE_API_KEY=
NAVIGATE_MODEL_EXTRACTION=nova-micro
NAVIGATE_MODEL_EMBEDDING=text-embedding-3-small
